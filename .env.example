# ListHoard quickstart environment.
# Copy to `.env` and fill; every value here is a placeholder — real secrets
# never go in a committed file, only your local `.env`.

# The only required provider key (Shippability ruling 15): a free TMDB key.
# Sign up at https://www.themoviedb.org/signup and grab your v3 key.
TMDB_API_KEY=your-tmdb-v3-key-here

# Timezone (IANA name, e.g. Europe/Berlin).
TZ=Etc/UTC

# Your existing postgres (or take the fullstack overlay's embedded one and
# set POSTGRES_HOST=postgres here).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=listhoard
POSTGRES_PASSWORD=placeholder-change-me
POSTGRES_DB=listhoard_catalog

# Your existing arrs (optional — the hoard browses fine without them; imports
# need them).
RADARR_BASE_URL=http://your-radarr:7878
SONARR_BASE_URL=http://your-sonarr:8989
RADARR_API_KEY=placeholder
SONARR_API_KEY=placeholder

# Optional Jellyfin (powers auth + in-library badges when present).
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=

# Auth mode (spec §7): jellyfin | local | token. Empty = first-run setup
# decides; token mode takes a shared secret.
# (These two land with shippability slice 2 — the app ignores them until then.)
LISTHOARD_AUTH_MODE=
LISTHOARD_ADMIN_TOKEN=

# Optional extra providers (each works key-less or degrades honestly).
TRAKT_CLIENT_ID=
MDBLIST_API_KEY=

# Where the UI answers.
LISTHOARD_PORT=8675
